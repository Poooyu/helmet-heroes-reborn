
{
  "name": "helmet-heroes-reborn",
  "version": "1.0.0",
  "description": "Helmet Heroes Reborn desktop launcher",
  "main": "main.js",
  "author": "Local User",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.helmetheroes.reborn",
    "productName": "Helmet Heroes Reborn",
